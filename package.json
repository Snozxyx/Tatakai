  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/animejs": "^3.1.13",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^42.11.16",
    "electron-builder": "^26.4.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "icon-gen": "^5.0.0",
    "jsdom": "30.0.1",
    "libpg-query": "18.1.4",
    "lovable-tagger": "^1.1.13",
    "pgsql-parser": "18.2.6",
    "postcss": "^8.5.6",
    "react-scan": "^0.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.36.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.3.5",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "baseline-browser-mapping": "latest",
    "caniuse-lite": "1.0.30001812",
    "adm-zip": "^0.6.1"
  },
  "build": {
    "appId": "app.tatakai.me",
    "productName": "Tatakai",
    "beforePack": "scripts/prepare-compatibility-package.cjs",
    "afterPack": "scripts/verify-desktop-package.cjs",
    "directories": {
      "output": "dist_electron",
      "buildResources": "resources"
    },
    "files": [
      "shared/aniyomi/java/**",
      "dist/**/*",
      "desktop/**/*",
      "tatakai-server/src/**/*",
      "tatakai-server/dist/**/*",
      "tatakai-server/package.json",
      "resources/**/*",
      "!resources/bin/**",
      "package.json",
      "src/core/player/subtitle-core.js",
      "src/core/download/candidate-scorer.cjs",
      "src/core/download/candidate-evaluator.cjs"
    ],
    "extraResources": [
      {
        "from": ".cache/compatibility-runtime-assets/desktop",
        "to": "compatibility-runtimes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "*/manifest.json",
          "*/dist/bundle.js"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!**/development/**"
        ]
      }
    ],
    "asarUnpack": [
      "desktop/runtime/compatibility/expand-runtime.ps1",
      "**/node_modules/@ffmpeg-installer/**",
      "**/node_modules/ffmpeg-static/**",
      "**/*.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "snozxyx",
        "repo": "Tatakai"
      }
    ],
    "win": {
      "signExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "Tatakai",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "uninstallDisplayName": "Tatakai ${version}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.entertainment",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "Tatakai ${version}",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Tatakai <noreply@github.com>",
      "icon": "resources/icon.png",
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@40.1.0": true
  }
}
