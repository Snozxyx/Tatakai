{
  "name": "tatakai",
  "private": true,
  "version": "6.4.2",
  "description": "Tatakai \u00e2\u20ac\u201d an extension-based otaku community for tracking anime & manga",
  "author": {
    "name": "Snozxyx",
    "email": "snozxyx@gmail.com"
  },
  "license": "MPL-2.0",
  "homepage": "https://tatakai.me",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "translate:build": "node scripts/build-translate-engine.mjs",
    "translate:build:dev": "node scripts/build-translate-engine.mjs --dev",
    "translate:test": "cargo test --locked --manifest-path translate-engine/Cargo.toml",
    "postinstall": "node scripts/fix-electron-install.cjs",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build:dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build --mode development",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/i18n-extract.mjs --check",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "bun test tests",
    "test:watch": "bun test --watch tests",
    "preview": "vite preview --host 0.0.0.0",
    "start": "cross-env NODE_ENV=production electron .",
    "electron:dev": "npm run translate:build:dev && concurrently \"vite\" \"wait-on http://localhost:8090 && cross-env ELECTRON_DEVTOOLS=1 electron desktop/main.cjs\"",
    "assets:installer": "node scripts/generate-installer-assets.cjs",
    "assets:cloudflared": "node scripts/fetch-cloudflared.cjs",
    "electron:build": "npm run server:build && npm run translate:build && npm run assets:installer && npm run assets:cloudflared && cross-env ELECTRON_BUILD=true NODE_OPTIONS=--max-old-space-size=6144 vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config.npmRebuild=false --config.electronDist=node_modules/electron/dist",
    "assets:generate": "node scripts/generate-assets.cjs",
    "server:build": "node tatakai-server/scripts/build.mjs",
    "server:start": "node tatakai-server/src/node.mjs",
    "server:test": "node --test tatakai-server/test/*.test.mjs",
    "mobile:dev": "npm run build:native && npx cap open android",
    "mobile:ios": "npm run build:native && npx cap open ios",
    "mobile:sync": "npm run build:native && npx cap sync",
    "mobile:sync:ios": "npm run build:native && npx cap sync ios",
    "mobile:build": "node scripts/build-android.mjs mobile",
    "tv:build": "node scripts/build-android.mjs tv",
    "tv:dev": "cross-env VITE_TV_MODE=true vite",
    "mobile:build:ios": "npm run build:native && npx cap sync ios",
    "mobile:build:ios:unsigned": "npm run build:native && npx cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO clean build",
    "altstore:generate": "node scripts/generate-altstore-source.mjs",
    "build:native": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=6144 vite build --mode native && node scripts/bundle-report.mjs --check-native",
    "build:report": "node scripts/bundle-report.mjs"
  },
  "dependencies": {
    "@biwills/kittentts": "^1.0.0",
