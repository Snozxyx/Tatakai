    "@sentry/node": "^10.33.0",
    "@sentry/react": "^10.33.0",
    "@sentry/tracing": "^7.120.4",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-virtual": "^3.13.24",
