    "qrcode.react": "^4.2.0",
    "quickjs-emscripten": "0.32.0",
    "react": "^18.3.1",
    "react-blurhash": "^0.3.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
