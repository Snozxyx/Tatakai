<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:banner="@drawable/tv_banner" android:label="Tatakai TV" tools:replace="android:label">
        <provider android:name=".tv.TvSearchProvider" android:authorities="${applicationId}.search" android:exported="true" />
        <activity android:name=".MainActivity" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter><action android:name="android.intent.action.SEARCH" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="android.app.searchable" android:resource="@xml/tv_searchable" />
        </activity>
        <activity android:name=".player.TvPlayerActivity" android:exported="false" android:screenOrientation="landscape" android:theme="@style/AppTheme.NoActionBar" android:hardwareAccelerated="true" android:configChanges="screenSize|screenLayout|uiMode|keyboardHidden" />
    </application>
</manifest>
