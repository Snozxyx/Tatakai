<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Match native chrome to Tatakai before the WebView/JS is ready. -->
        <item name="android:windowBackground">#09090B</item>
        <item name="android:statusBarColor">#09090B</item>
        <item name="android:navigationBarColor">#09090B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <!-- Do NOT use Theme.SplashScreen here. On Android 12+ (API 31+),
             Theme.SplashScreen installs a system-owned splash surface at z=30000
             that only dismisses when installSplashScreen() is called before
             setContentView() — but Capacitor's BridgeActivity calls setContentView()
             inside super.onCreate() before the SplashScreen plugin can call
             installSplashScreen(). The result is a permanent black screen.
             Using AppTheme.NoActionBar as parent lets Capacitor manage the splash
             entirely via its own overlay/dialog, which works correctly on all APIs. -->
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
