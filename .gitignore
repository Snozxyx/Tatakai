# ── Desktop packaging: keep large / generated binaries out of git ────────────
# cloudflared is fetched per-platform at build time — locally by
# scripts/fetch-cloudflared.cjs, on GitHub by the "Download cloudflared" CI step
# — so the ~55 MB binary never enters the repo.
resources/bin/cloudflared
resources/bin/cloudflared.exe
!resources/bin/.gitkeep

# NSIS installer graphics are generated from brand tokens by
# scripts/generate-installer-assets.cjs (locally + in CI). Keep the generated
# BMPs/PNGs out of git; the hand-authored build/installer.nsh stays tracked.
build/installerSidebar.bmp
build/uninstallerSidebar.bmp
build/installerHeader.bmp
build/preview-*.png

# ── Capacitor: generated shell output (regenerated by `npx cap sync`) ────────
android/.gradle/
android/build/
android/app/build/
ios/build/
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/App/App/public/
ios/App/DerivedData/
xcuserdata/
android/app/release.keystore

# ── Backend repo lives separately ────────────────────────────────────────────
# The Node/Express API is published in its own repository (removed as a
# submodule; CI no longer checks it out). It was 100 MB of vendored node_modules
# here and would blow the clone size out.
/tatakaiapi/

# ── Local scratch / tooling output ────────────────────────────────────────────
.21st/
scripts/scratch-inspect.cjs
scripts/_notif_icons.mjs

# One-off screenshot script (needs Playwright, which isn't available here).
navshot.cjs

# Android device dumps used while debugging the native shell (ui-automator
# hierarchies + window snapshots + emulator screenshots) — large, never code.
android/app-live.xml
android/window.xml
android/settings.xml
android/emulator-screenshot.png
android/tatakai-live.png
