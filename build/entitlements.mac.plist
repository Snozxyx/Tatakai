<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow JIT-compiled code (Electron / V8). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Allow unsigned executable memory (bundled native modules:
       node-datachannel, ffmpeg/ffprobe helpers). -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Bundled native modules are not signed with the app identity. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Outbound + local-server networking (Supabase, update feed,
       watch-party tunnel, home server). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Open/Save panels + offline downloads. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
