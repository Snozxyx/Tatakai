# Tatakai - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Web Configuration (Vite)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_BACKEND_ORIGIN=https://api.your-domain.com
VITE_ADMIN_API_SECRET=must_match_tatakaiapi_admin_secret
VITE_TATAKAI_API_URL=https://api.tatakai.me:4000/api/v1
VITE_HIANIME_API_URL=https://api.tatakai.me/api/v2/hianime
VITE_MANGA_API_URL=https://core.tatakai.me/api/v2/manga
VITE_LOCAL_HIANIME_ORIGIN=https://api.tatakai.me

# Cloudflare Turnstile (bot protection)
# Public site key for the widget on the auth flow + suggestion/report forms.
# Empty = disabled (the widget won't render and the forms fall back to the math
# captcha / proceed; the DB automod + rate-limit backstop still applies).
# For the AUTH flow to actually enforce the token, also configure the same
# Turnstile secret in the Supabase dashboard (Auth → Bot & Abuse Protection).
VITE_TURNSTILE_SITE_KEY=
# The matching SECRET key lives server-side in tatakaiapi/.env as
# TURNSTILE_SECRET_KEY (used by /api/v3/security/turnstile/verify). Never ship
# the secret to the client. Empty there = server verify fails open.

# MyAnimeList Integration
# NOTE: the OAuth token exchange runs server-side in TatakaiAPI, so the CLIENT_ID
# and CLIENT_SECRET below must ALSO be present in TatakaiAPI/.env (same var names).
VITE_MAL_CLIENT_ID=your_mal_client_id
VITE_MAL_CLIENT_SECRET=your_mal_client_secret
VITE_MAL_REDIRECT_URI=your_mal_redirect_uri
VITE_MAL_AUTH_FUNCTION_URL=your_supabase_function_url_for_mal_auth
# Desktop uses the SAME https redirect as web plus a `state` bridge marker — the
# web callback page forwards desktop flows to the app via `tatakai://`
# internally. Only the https URI above needs registering in the MAL app settings
# (you may additionally register tatakai://integration/mal/redirect, but it is
# no longer required). Kept for backwards compat:
VITE_MAL_DESKTOP_REDIRECT_URI=tatakai://integration/mal/redirect

# AniList Integration
VITE_ANILIST_CLIENT_ID=your_anilist_client_id
VITE_ANILIST_CLIENT_SECRET=your_anilist_client_secret
VITE_ANILIST_REDIRECT_URI=your_anilist_redirect_uri
# Desktop uses the SAME https redirect as web (AniList allows only ONE redirect
# URI per app, so it must be the https one). The web callback page forwards
# desktop flows to the app via `tatakai://` internally — never register the
# deep link in AniList. Kept for backwards compat:
VITE_ANILIST_DESKTOP_REDIRECT_URI=tatakai://integration/anilist/redirect

# Proxy Loader (Node)
# Comma-separated proxy URLs, first entry should be the primary node proxy.
VITE_PROXY_POOL_URLS=https://hoko.tatakai.me/api/v1/streamingProxy
# Cloudflare Worker streaming proxy (see cloudflare-worker/). Deploy it, then set:
#   VITE_PROXY_CF_URL=https://tatakai-streaming-proxy.<subdomain>.workers.dev/api/v1/streamingProxy
# Its PROXY_PASSWORD secret must equal VITE_STREAM_PROXY_PASSWORD below.
VITE_PROXY_CF_URL=
VITE_PROXY_NODE_URL=https://hoko.tatakai.me/api/v1/streamingProxy
VITE_PROXY_BUN_URL=

# Streaming Proxy (Node)
# Example URL: https://proxy.your-domain.com/api/v1/streamingProxy
VITE_STREAM_PROXY_URL=https://hoko.tatakai.me/api/v1/streamingProxy
VITE_STREAM_PROXY_PASSWORD=your-shared-proxy-password

# Mobile Configuration (Flutter)
API_BASE_URL=your_api_base_url
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=your_database_url
PROXY_URL=your_proxy_url
WATCHANIMEWORLD_SCRAPER_URL=your_scraper_url

# Comment GIF picker (Giphy). Public/beta API key from developers.giphy.com.
# When empty, the comment GIF picker shows a "not configured" state instead.
VITE_GIPHY_API_KEY=

# Analytics
VITE_GA_MEASUREMENT_ID=your_google_analytics_id
VITE_DD_SITE=datadoghq.com
VITE_DD_CLIENT_TOKEN=your_datadog_client_token

# Extractor Service (Local Development)
VITE_EXTRACTOR_SERVICE_URL=https://api.tatakai.me:3001

# Extension Service (marketplace catalogue behind /extensions)
# Base must include the `/api` segment: the service mounts both its catalogue
# routes (`/api/extension...`) and its download redirect (`/api/download/...`)
# under it — the sibling `/download/...` is a 404.
VITE_EXTENSION_API_URL=https://extension.tatakai.me/api
# Only needed when a deployment serves extension artwork from a *public* bucket
# as relative paths (`<owner>/<ext>/icon-<ts>.jpeg`). The service normally signs
# `icon_url` / `banner_url` and returns absolute URLs, so leave this empty.
VITE_EXTENSION_ASSET_BASE=
# Where the store's Publish button sends the user. Defaults to the value below.
VITE_EXTENSION_PORTAL_URL=https://extension.tatakai.me

# Discord Community Page (/discord)
# Enable widget in Discord: Server Settings → Widget → Enable Server Widget
VITE_DISCORD_GUILD_ID=1465759865539526973
VITE_DISCORD_INVITE=https://discord.gg/tatakai

# Discord Activity (embedded app in voice channels)
# Application ID from Discord Developer Portal with Activities enabled
VITE_DISCORD_CLIENT_ID=your_discord_activity_app_id

# Backend Discord Webhooks (TatakaiAPI)
DISCORD_WEBHOOK_STATUS=
# Crash webhook — the /api/v3/crash route posts a crash embed here when the
# desktop app forwards crash metadata. Server-side ONLY so the secret never
# ships to clients; empty disables the Discord forward (the crash is still
# persisted to the crash_reports table). Consumed via tatakaiapi env.
CRASH_DISCORD_WEBHOOK=

# Pretty API logs in local development
TATAKAI_LOG_PRETTY=true

# API Encryption Secret (must match TatakaiAPI's API_SECRET)
# Leave empty to disable request signing
VITE_API_SECRET=

# Desktop
TATAKAI_EXT_PUBLIC_KEY=

# ── SEO / social share preview (web server: scripts/ptero-start.mjs) ──
# The static Node server injects per-entity Open Graph / Twitter meta into
# dist/index.html for shareable routes (anime, manga, profile, post, tier list,
# playlist) so social crawlers get a tailored card. Both are optional — sane
# defaults are used when unset.
#   SHARE_API_ORIGIN — TatakaiAPI origin the server calls for /api/public/share/*
#                      and generated /api/og/* cards. Defaults to
#                      VITE_BACKEND_ORIGIN, then https://api.tatakai.me.
#   SITE_ORIGIN      — canonical public origin used for canonical/og:url and
#                      absolute image URLs. Defaults to https://tatakai.me.
SHARE_API_ORIGIN=
SITE_ORIGIN=https://tatakai.me

# Desktop crash forwarding (metadata only — no dumps, no PII)
# On next launch the desktop process auto-forwards crash METADATA in ONE upload
# to the backend crash-ingest route. tatakaiapi then fans it out server-side to
# both the Supabase crash_reports table (via the service-role client — the
# desktop never holds a Supabase key) and the Discord webhook. The desktop no
# longer posts to Discord itself, so CRASH_DISCORD_WEBHOOK is a SERVER var (see
# the Backend Discord Webhooks section above / tatakaiapi env), not a desktop one.
#   CRASH_REPORT_ENDPOINT  — desktop-side override for the ingest URL. Defaults to
#                            ${VITE_BACKEND_ORIGIN}/api/v3/crash, so normally
#                            leave this empty and just set VITE_BACKEND_ORIGIN.
CRASH_REPORT_ENDPOINT=