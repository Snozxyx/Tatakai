{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tatakai/release-parser": ["./desktop/runtime/torrent/naming/release-parser.cjs"],
      "@tatakai/candidate-scorer": ["./src/core/download/candidate-scorer.cjs"],
      "@tatakai/candidate-evaluator": ["./src/core/download/candidate-evaluator.cjs"]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false
  }
}
