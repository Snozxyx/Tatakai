{
  "id": "tatakai.extension.toko",
  "name": "Toko",
  "type": "custom",
  "version": "1.1.0",
  "author": "Snozxyx",
  "description": "The official all-in-one Tatakai extension. Primary streaming via Nebula (AniList-keyed, direct HLS), plus anime direct streaming (Animepahe, Anikoto, Anizone, Senshi, Animeya, Toonstream, Reanime, Aniworld, 4Anime, Animelok, Watchanimeworld, Animesalt), torrent discovery (Nyaa, ACG.RIP, Animetosho, SubPlease, Seadex, nekoBT), and manga reading (Animesama, AsuraScan, Atsumaru, AllManga, MangaFire).",
  "categories": ["Anime Stream", "Torrent", "Manga"],
  "capabilities": ["manga", "preview"],
  "apiServer": {
    "namespace": "toko",
    "contract": "streaming-sources-v3",
    "routes": ["sources", "stream", "torrent"],
    "healthPath": "/health"
  },
  "sideloaded": true,
